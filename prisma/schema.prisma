// نموذج البيانات مصمّم لكل المراحل (الأسبوعي، الاستراتيجية، الأتمتة، الإشعارات)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Status {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum KpiDirection {
  UP
  DOWN
}

enum CycleStatus {
  ACTIVE
  CLOSED
}

// المرحلة 2: المنظورات الأربعة (بطاقة الأداء المتوازن)
enum Perspective {
  FINANCE
  IMPACT
  SYSTEM
  GROWTH
}

// هدف الدورة: أولوية نشطة (OKR) أو صيانة (ADR-004)
enum GoalKind {
  OKR
  MAINTENANCE
}

enum OkrType {
  COMMITTED
  ASPIRATIONAL
}

enum MetricRole {
  LEADING
  LAGGING
}

// إعدادات عامة (صف واحد id=1)
model Settings {
  id                  Int       @id @default(1)
  weekStartDay        Int       @default(0) // 0 = الأحد
  timezone            String    @default("Asia/Kuwait")
  locale              String    @default("ar")
  theme               String    @default("dark") // time | system | light | dark (dark = فضاء ونجوم، light = سما الفجر)
  dayBlocks           Json? // أوقات الدوام الثابتة لخط اليوم: [{label, start, end, kind}]
  remindDaily         Boolean   @default(true)
  remindPlanThursday  Boolean   @default(true)
  remindKpiFriday     Boolean   @default(true)
  remindSummarySunday Boolean   @default(true)
  lastAutomationDate  DateTime? @db.Date // آخر يوم اشتغلت فيه الأتمتة (المرحلة 3)
  updatedAt           DateTime  @updatedAt
  profileLearnedAt    DateTime?
  agentSeenAt         DateTime?
}

// ===== الاستراتيجية =====
model Cycle {
  id        String          @id @default(cuid())
  name      String
  startDate DateTime        @db.Date
  endDate   DateTime        @db.Date
  status    CycleStatus     @default(ACTIVE)
  closedAt  DateTime?
  snapshot  Json? // الأرقام النهائية لما تخلص الدورة
  goals     Goal[]
  kernel    StrategyKernel?
  notDoing  NotDoing[]
  createdAt DateTime        @default(now())
}

model Pillar {
  id          String       @id @default(cuid())
  habits      Habit[]
  wheel       WheelScore[]
  name        String
  color       String
  order       Int          @default(0)
  archived    Boolean      @default(false)
  perspective Perspective? // المحور تحت أي منظور
  goals       Goal[]
  notDoing    NotDoing[]
  createdAt   DateTime     @default(now())
}

model Goal {
  id              String         @id @default(cuid())
  cycleId         String
  cycle           Cycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  pillarId        String
  pillar          Pillar         @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  title           String
  notes           String?
  dueDate         DateTime?      @db.Date
  weight          Int            @default(3) // 1..5
  order           Int            @default(0)
  archived        Boolean        @default(false)
  copiedFromId    String? // لما تنسخ أهداف دورة سابقة
  // مؤشر القياس (اختياري)
  kpiName         String?
  kpiUnit         String?
  kpiStart        Float?
  kpiTarget       Float?
  kpiDirection    KpiDirection?
  readings        KpiReading[] // قديم: بينشال بخطوة «قلّص» (ADR-003)
  // المرحلة 2: OKR أو صيانة
  kind            GoalKind       @default(MAINTENANCE)
  rank            Int? // 1..3 للـ OKR، null للصيانة
  okrType         OkrType?
  weeklyHours     Float? // ميزانية الوقت بالأسبوع
  strategicGoalId String?
  strategicGoal   StrategicGoal? @relation(fields: [strategicGoalId], references: [id], onDelete: SetNull)
  metrics         Metric[] // للـ OKR = النتائج الرئيسية
  supports        GoalSupport[]  @relation("supporter")
  supportedBy     GoalSupport[]  @relation("supported")
  planTasks       PlanTask[]
  weeklyTasks     WeeklyTask[]
  recurrences     Recurrence[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([cycleId, rank]) // بيمنع OKR رابع حتى لو صار سباق (DDIA)
  @@index([cycleId])
}

model KpiReading {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  value     Float
  note      String?
  createdAt DateTime @default(now())

  @@unique([goalId, weekStart])
}

// «بيدعم»: الهدف from بيدعم الهدف to
model GoalSupport {
  fromId String
  from   Goal   @relation("supporter", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Goal   @relation("supported", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

// الخطة: مهمة ← مهام صغيرة ← خطوات
model PlanTask {
  id        String        @id @default(cuid())
  goalId    String
  goal      Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  order     Int           @default(0)
  subtasks  PlanSubtask[]
  createdAt DateTime      @default(now())
}

model PlanSubtask {
  id          String       @id @default(cuid())
  planTaskId  String
  planTask    PlanTask     @relation(fields: [planTaskId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime?    @db.Date
  status      Status       @default(NOT_STARTED) // إذا إلها خطوات بتنحسب منها
  order       Int          @default(0)
  steps       PlanStep[]
  weeklyTasks WeeklyTask[]
  createdAt   DateTime     @default(now())
}

model PlanStep {
  id          String       @id @default(cuid())
  subtaskId   String
  subtask     PlanSubtask  @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime?    @db.Date
  status      Status       @default(NOT_STARTED)
  order       Int          @default(0)
  weeklyTasks WeeklyTask[]
  createdAt   DateTime     @default(now())
}

// ===== التقرير الأسبوعي =====
model WeeklyTask {
  id            String           @id @default(cuid())
  weekStart     DateTime         @db.Date
  title         String
  goalId        String? // null = «اعتيادي»
  goal          Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  notes         String?
  progress      Int? // نسبة إنجاز 0..100
  imageData     String? // صورة مصغّرة (data URL)
  status        Status           @default(NOT_STARTED)
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  stuck         Boolean          @default(false)
  stuckNote     String?
  order         Int              @default(0)
  // الترحيل والأتمتة
  carriedFromId String?          @unique
  carriedFrom   WeeklyTask?      @relation("carry", fields: [carriedFromId], references: [id], onDelete: SetNull)
  carriedTo     WeeklyTask?      @relation("carry")
  carryCount    Int              @default(0)
  isAuto        Boolean          @default(false) // انعملت لحالها (ترحيل/تكرار/خطة)
  touchedAt     DateTime? // آخر تعديل مني أنا (مش من الأتمتة)
  // الربط
  recurrenceId  String?
  recurrence    Recurrence?      @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  planSubtaskId String?
  planSubtask   PlanSubtask?     @relation(fields: [planSubtaskId], references: [id], onDelete: SetNull)
  planStepId    String?
  planStep      PlanStep?        @relation(fields: [planStepId], references: [id], onDelete: SetNull)
  steps         WeeklyTaskStep[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([recurrenceId, weekStart])
  @@index([weekStart])
}

model WeeklyTaskStep {
  id     String     @id @default(cuid())
  taskId String
  task   WeeklyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title  String
  done   Boolean    @default(false)
  order  Int        @default(0)
}

// قالب المهمة المتكررة «كل أسبوع»
model Recurrence {
  id        String       @id @default(cuid())
  title     String
  goalId    String?
  goal      Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  notes     String?
  steps     Json? // عناوين الخطوات
  startWeek DateTime     @db.Date
  stoppedAt DateTime?    @db.Date // أول أسبوع ما بتنعمل فيه نسخة
  tasks     WeeklyTask[]
  createdAt DateTime     @default(now())
}

// مراجعة الأسبوع
model WeekReview {
  weekStart DateTime  @id @db.Date // الأسبوع الي عم نراجعه
  learned   String?
  top3      Json? // ["...", "...", "..."]
  seenAt    DateTime?
  updatedAt DateTime  @updatedAt
}

// ===== التذكيرات (المرحلة 4) =====
model Notification {
  id        String    @id @default(cuid())
  kind      String // daily | plan_thursday | kpi_friday | summary_sunday | carry_alert | dormant_goal
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ===== المرحلة 2: الاستراتيجية =====
// النواة (Rumelt): التحدي ← السياسة الموجّهة ← النيّة الجوهرية
model StrategyKernel {
  cycleId          String   @id
  cycle            Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  coreChallenge    String?
  guidingPolicy    String?
  guidingPolicyNot String?
  essentialIntent  String?
  freeHours        Float? // الساعات الحرة بالأسبوع (لحد ما ينبني تدقيق الوقت)
  isDraft          Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

// هدف استراتيجي لـ 3 سنين بمنظور
model StrategicGoal {
  id          String      @id @default(cuid())
  perspective Perspective
  title       String
  horizonEnd  DateTime    @db.Date
  order       Int         @default(0)
  archived    Boolean     @default(false)
  isDraft     Boolean     @default(false)
  goals       Goal[]
  metrics     Metric[]
  createdAt   DateTime    @default(now())
}

// قائمة «لا» والتقصير الاستراتيجي (Essentialism)
model NotDoing {
  id        String   @id @default(cuid())
  cycleId   String
  cycle     Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  pillarId  String?
  pillar    Pillar?  @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  text      String
  reason    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ===== المرحلة 2: القياس =====
// المؤشر كيان مستقل (ADR-003): نتيجة رئيسية لـ OKR، أو مؤشر هدف صيانة، أو مؤشر هدف استراتيجي
model Metric {
  id              String          @id @default(cuid())
  name            String
  unit            String?
  start           Float?
  target          Float?
  direction       KpiDirection
  role            MetricRole      @default(LAGGING)
  order           Int             @default(0)
  goalId          String?
  goal            Goal?           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  strategicGoalId String?
  strategicGoal   StrategicGoal?  @relation(fields: [strategicGoalId], references: [id], onDelete: Cascade)
  readings        MetricReading[]
  createdAt       DateTime        @default(now())

  @@index([goalId])
}

// القراءات «إضافة وتعديل بس» (ADR-007)
model MetricReading {
  metricId  String
  metric    Metric   @relation(fields: [metricId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  value     Float
  note      String?
  source    String   @default("MANUAL")
  createdAt DateTime @default(now())

  @@id([metricId, date])
}

// ===== المرحلة 3، الشريحة 1: اليوم =====
// سجل اليوم: النية الصبح، الطاقة والمزاج، ومراجعة المسا (الرواقيين)
model DayLog {
  date      DateTime @id @db.Date
  intent    String?
  energy    Int? // 1..5
  mood      Int? // 1..5
  evening   String?
  updatedAt DateTime @updatedAt
}

// العادات (Atomic Habits): كل عادة إلها محور، وممكن تغذّي مؤشر قائد
model Habit {
  id        String       @id @default(cuid())
  name      String
  icon      String       @default("Circle")
  pillarId  String?
  pillar    Pillar?      @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  metricId  String?
  order     Int          @default(0)
  archived  Boolean      @default(false)
  checks    HabitCheck[]
  createdAt DateTime     @default(now())
}

model HabitCheck {
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@id([habitId, date])
}

// صندوق الالتقاط: كل شي بتحكيه أو بتكتبه بسرعة. المستشار بيفرزه لحاله بمرحلته
model Capture {
  id          String        @id @default(cuid())
  text        String
  source      String        @default("TEXT") // TEXT | VOICE
  processedAt DateTime?
  analyzer    String? // CLAUDE | RULES (لما ما في مفتاح)
  error       String?
  items       CaptureItem[]
  createdAt   DateTime      @default(now())

  @@index([processedAt])
}

// كل شي استخرجه المستشار من كلامك وطبّقه لحاله، مع اللي بيلزم للتراجع (Command pattern)
model CaptureItem {
  id        String    @id @default(cuid())
  captureId String
  capture   Capture   @relation(fields: [captureId], references: [id], onDelete: Cascade)
  kind      String // TASK | HABIT | EXPENSE | METRIC | ENERGY | MOOD | NOTE
  summary   String
  chain     String? // «مهمة ← أولوية ١ ← هدف ← رؤية»
  refType   String?
  refId     String?
  undo      Json?
  undoneAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

model Expense {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  amount    Float
  currency  String   @default("KWD")
  category  String
  note      String?
  createdAt DateTime @default(now())

  @@index([date])
}

// محادثة المستشار (بتنحفظ عشان يتذكّر)
model AdvisorMessage {
  id        String   @id @default(cuid())
  role      String // user | assistant
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ===== البوصلة (التوجيه): رؤية، رسالة، قيم، مبادئ، هوية (منهجية §1) =====
model Compass {
  id         Int      @id @default(1)
  bhag       String? // الهدف الكبير الجريء (Collins)
  picture3y  String? // صورة حياتي بعد 3 سنين
  mission    String?
  winning    String? // «الفوز إلي يعني…» (Playing to Win)
  why        String? // بطاقة «ليش» (فرانكل)
  eulogy     String? // تمرين يوم التأبين (Covey)
  enough     Float? // رقم «كفاية» بالدينار بالشهر (Housel)
  enoughNote String?
  updatedAt  DateTime @updatedAt
}

model CompassItem {
  id        String   @id @default(cuid())
  kind      String // VALUE | PRINCIPLE | IDENTITY
  text      String
  detail    String? // للقيمة: تعريفها السلوكي
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([kind])
}

// ===== التشخيص: لوحة الحياة وSWOT (منهجية §2) =====
model WheelScore {
  date     DateTime @db.Date
  pillarId String
  pillar   Pillar   @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  score    Int
  note     String?

  @@id([date, pillarId])
}

model SwotItem {
  id        String   @id @default(cuid())
  kind      String // S | W | O | T
  text      String
  createdAt DateTime @default(now())
}

// ===== سجل القرارات (Kahneman، Dalio): خيارات، قاعدة 90%، Premortem، فحص تحيّزات، ومراجعة =====
model Decision {
  id          String    @id @default(cuid())
  title       String
  context     String?
  options     Json // [{ text, score }]
  chosen      String?
  why         String?
  premortem   String?
  outsideView String?
  biases      Json? // مفاتيح التحيّزات الي انفحصت
  reviewAt    DateTime? @db.Date
  outcome     String?
  lesson      String?
  status      String    @default("OPEN") // OPEN | DECIDED | REVIEWED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

// ── الملف الحي (Stage 3): شو بيعرف التطبيق عن عمر، وهو بيصحّحه ──
model ProfileFact {
  id         String   @id @default(cuid())
  area       String // VALUES | ENERGY | HABITS | PROCRASTINATION | TRIGGERS | MONEY | STRENGTHS | PREFERENCES
  key        String?  @unique // للمستنتج من البيانات: مفتاح ثابت لينحدّث بدل ما يتكرّر
  text       String
  evidence   String?
  source     String // DATA | CLAUDE | ME
  confidence Float    @default(0.5)
  status     String   @default("NEW") // NEW | CONFIRMED | REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([area])
}

// دفتر العلاقات (Carnegie, Covey): الناس المهمين بحياته
model Person {
  id          String    @id @default(cuid())
  name        String
  relation    String? // أهل، صاحب، شغل، ...
  note        String?
  lastContact DateTime? @db.Date
  source      String    @default("ME") // ME | CLAUDE
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── الوكيل على اللابتوب (Stage 5): طابور مهام. الملفات والأرقام بتضل على اللابتوب؛ هون عنوان وحالة وملخّص بدون أرقام ──
model AgentJob {
  id           String    @id @default(cuid())
  kind         String // EXCEL_REPORT | EMAIL | OTHER
  title        String
  instructions String
  folder       String? // اسم المجلد على اللابتوب (مش محتواه)
  status       String    @default("QUEUED") // QUEUED | RUNNING | NEEDS_APPROVAL | APPROVED | SENDING | DONE | FAILED | CANCELLED
  standing     Boolean   @default(false) // إذن دائم: بيبعت بدون ما يستنى
  repeatDay    Int? // تقرير أسبوعي: يوم الأسبوع 0..6
  summary      String? // ملخّص قصير بدون أرقام الشركة
  nextRunAt    DateTime?
  claimedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}
